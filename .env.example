# Copy to .env.local for development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server.

# Public origin of this app (https required outside localhost).
APP_URL=http://localhost:3000

# Trusted server-side Base Sepolia RPC. Defaults to the public endpoint if unset.
# Never expose this as NEXT_PUBLIC_*.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Required. The MVP refuses to start unless fiat payout is simulation-only.
FIAT_PAYOUT_MODE=simulation

# Supabase. For local development, copy values from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
